      "zlljet":   { "tiers": ["mc", "data", "ratio"], "etaBins": [0], "types": ["mpfchs1", "ptchs", "chf", "nef", "nhf", "cef", "muf", "mpf1", "mpfn", "mpfu", "rho"], "alphas": [0.10, 0.15, 0.20, 0.30, 0.50, 1.00] },
