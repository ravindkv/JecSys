{
  "_doc": "Reprocess (was reprocess.C): merges the inputs of the analysis groups into the pre-fit file ('forfit' of config/Inputs.json). Part 1 reads, cleans and corrects one graph per (tier, eta bin, type, sample, alpha) and writes it to <tier>/eta<..>/<type>_<sample>_a<alpha> (uncleaned copy in orig/). Part 2 writes the Z mass histograms. Part 3 writes the JEC reference bands and L1 systematics to ratio/eta<..>/. Supported: the epochs of config/Inputs.json at corLevel L1L2L3Res. Dropped from reprocess.C (dead for these epochs): Run2Test, 2017H, the sub-IOVs, corLevel L1L2Res/L1L2, dijet inputs, multijetMode leading/recoil, zjetMode jetpt/ptave, the unused h2eta input (toDo D4), the fitted (useFixedFit=false) mass corrections, the mass-correction uncertainties (correctUncert=false), the PS-weight variants (all empty), and the JEC that is computed but overwritten for every supported epoch.",

  "default": {
    "verbose": true,
    "_verboseNote": "print removed points and the JEC files that are read, as reprocess.C (rp_debug)",

    "tiers": ["mc", "data", "ratio"],
    "etaBins": [[0, 1.305], [0, 2.5]],
    "types": ["counts", "crecoil", "mpfchs1", "ptchs", "chf", "nef", "nhf", "cef", "muf", "puf",
              "mpf1", "mpfn", "mpfu", "rho", "rjet", "gjet"],
    "alphas": [0.10, 0.15, 0.20, 0.30, 0.50, 1.00],
    "fractions": ["chf", "nef", "nhf", "cef", "muf", "puf"],
    "mpfComponents": ["mpf1", "mpfn", "mpfu", "rho"],
    "_orderNote": "tiers, eta bins, types and samples are processed in this order: data and mc before ratio, counts before the graphs they clean, zeejet/zmmjet before zlljet.",

    "samples": ["incjet", "multijet", "gamjet", "zeejet", "zmmjet", "zlljet", "zjet", "hadw", "pfjet",
                "@zjetFlavor", "@zjetFlavorMc", "@gamjetFlavor", "@gamjetFlavorMc"],
    "flavorSets": {
      "_note": "@zjetFlavor = z + tag letter (zi, zb, ...), @zjetFlavorMc = z + tag + generator letter (zii, zib, ..., MC only); the same with g for gamma+jet. Their parent sample is zjet or gamjet.",
      "zjet":   { "prefix": "z", "letters": ["i", "b", "c", "q", "g", "n"] },
      "gamjet": { "prefix": "g", "letters": ["i", "b", "c", "q", "g", "n"] }
    },

    "products": {
