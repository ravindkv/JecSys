      "multijet": { "tiers": ["mc", "data", "ratio"], "etaBins": [0], "types": ["counts", "crecoil", "mpfchs1", "ptchs", "mpf1", "mpfn", "mpfu"], "alphas": [0.15, 0.20, 0.30] },
      "gamjet":   { "tiers": ["mc", "data", "ratio"], "etaBins": [0], "types": ["counts", "mpfchs1", "ptchs", "mpf1", "mpfn", "mpfu"], "alphas": [0.10, 0.15, 0.20, 0.30, 0.50, 1.00] },
