# Only code is in git: sources, build files and scripts, the JSON configuration and the
# documentation. This file is an allowlist: everything is ignored (ROOT files, text and
# JSON outputs, plots, logs, build products, executables, external inputs), then the code
# is let back in. To add another kind of file, add a "!" pattern below.
*
!*/
!PROMPTME.txt
# code
!*.cpp
!*.cc
!*.h
!*.C
!*.py
!Makefile
!*.sh
# configuration (config/, input/config/, test/Inputs.golden.json)
!*.json
# documentation and notes
!*.md
!toDo.txt
!doc/**/*.txt
!.gitignore

# Data and build directories stay out completely, whatever they contain.
/obj/
/output/
/test/golden/
/input/obj/
/input/prefit/
/input/forfit/
/input/test/golden/
